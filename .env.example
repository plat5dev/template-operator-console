# Build-time settings. Copy to .env.local for `bun run dev`.
# The container image takes the same settings at start, without VITE_ (see README).
# On Cloudflare Pages, set them as project environment variables.

# Required. The operator gateway. Its ALLOWED_ORIGINS must include this console's origin.
VITE_GATEWAY_URL=http://localhost:5410

# Required. Operator IdP (OIDC, or OAuth 2.0 metadata like Plat5 Auth). Must equal the gateway's AUTH_ISSUER exactly.
VITE_AUTH_ISSUER=http://localhost:5411

# Required. A public client (no secret) at that IdP, with PKCE and <origin>/callback as a redirect URI.
# The access token's aud must be in the gateway's AUTH_AUDIENCES.
VITE_AUTH_CLIENT_ID=operator-console

# Optional. Default "openid email profile".
# VITE_AUTH_SCOPES=openid email profile

# Optional. Only for IdPs that take an audience on /authorize (e.g. Auth0).
# VITE_AUTH_AUDIENCE=
